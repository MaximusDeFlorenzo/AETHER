# Copy to infra/.env.production on the VPS (gitignored) and fill in.
# Used twice by infra/docker-compose.prod.yml: for ${...} interpolation
# (--env-file) and as the api container's environment (env_file).
# Generate secrets with: openssl rand -hex 32

# --- Domains / TLS (both A records must point at the VPS IP) ---
API_DOMAIN=api.aetherguard.id
MEDIA_DOMAIN=media.aetherguard.id
ACME_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_USER=aether
POSTGRES_PASSWORD=
POSTGRES_DB=aether

# --- apps/api secrets ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=
# Exact Vercel origin(s), comma-separated, no trailing slash.
CORS_ORIGIN=https://aetherguard.id,https://www.aetherguard.id
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Storage (MinIO in this stack) ---
STORAGE_REGION=us-east-1
STORAGE_BUCKET=aether-media
STORAGE_ACCESS_KEY_ID=aether
STORAGE_SECRET_ACCESS_KEY=

# --- Ingestion adapters (see ../.env.example for what each one does) ---
BMKG_POLL_INTERVAL_MS=300000
NASA_FIRMS_POLL_INTERVAL_MS=3600000
WEATHER_POLL_INTERVAL_MS=900000
LANDSLIDE_TRIGGER_POLL_INTERVAL_MS=900000
SENTINEL_POLL_INTERVAL_MS=3600000
PETABENCANA_POLL_INTERVAL_MS=900000
RISK_NOTIFICATION_THRESHOLD=60
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
NASA_FIRMS_API_KEY=
NASA_FIRMS_SOURCES=
# Keep this low on a 20 GB disk.
HOTSPOT_RETENTION_DAYS=60
SENTINEL_BASE_URL=https://services.sentinel-hub.com
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
# OPENAQ_API_KEY=

# --- Web Push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Background jobs ---
VILLAGE_POPULATION_IMPORT_CHUNK_SIZE=1000
VILLAGE_POPULATION_IMPORT_VALIDATION_CONCURRENCY=1
VILLAGE_POPULATION_IMPORT_CONFIRM_CONCURRENCY=1

# --- Karhutla ---
KARHUTLA_PREDICTION_INTERVAL_MS=10800000
KARHUTLA_MAX_CLUSTERS=8
KARHUTLA_HOTSPOT_WINDOW_HOURS=24
KARHUTLA_SETTLEMENTS_ENABLED=true
GROUND_REPORTS_MAX_PER_HOUR=10

# --- Rainfall Intelligence ---
RAINFALL_INGESTION_INTERVAL_MS=10800000
GSMAP_FTP_HOST=hokusai.eorc.jaxa.jp
GSMAP_FTP_USER=
GSMAP_FTP_PASSWORD=
GSMAP_INGESTION_INTERVAL_MS=3600000
TERRAIN_SAMPLING_DISTRICTS_PER_DAY=60
GSMAP_ARCHIVE_FROM=2024-01-01
GSMAP_ARCHIVE_DAYS_PER_RUN=4
DIBI_LABELS_FROM_YEAR=2023
