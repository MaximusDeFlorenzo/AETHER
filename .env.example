# --- Shared / compose-level ---
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether
POSTGRES_DB=aether
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- apps/api ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://aether:aether@postgres:5432/aether
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AI_ENGINE_URL=http://ai-engine:8000
INTERNAL_SERVICE_TOKEN=dev-internal-token
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@aether.local
ADMIN_PASSWORD=ChangeMe123!

# Ingestion adapters
BMKG_POLL_INTERVAL_MS=300000
NASA_FIRMS_POLL_INTERVAL_MS=3600000
WEATHER_POLL_INTERVAL_MS=900000
LANDSLIDE_TRIGGER_POLL_INTERVAL_MS=900000
SENTINEL_POLL_INTERVAL_MS=3600000
RISK_NOTIFICATION_THRESHOLD=60

# Phase 2 ingestion adapters — weather/FIRMS/Sentinel credentials are blank
# until you supply real ones (each adapter gracefully no-ops without them);
# NASA_FIRMS_BASE_URL/SENTINEL_BASE_URL have working public defaults.
# The landslide-trigger adapter (landslide.adapter.ts) reuses
# WEATHER_API_BASE_URL/WEATHER_API_KEY — no separate credential needed.
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
NASA_FIRMS_API_KEY=
SENTINEL_BASE_URL=https://services.sentinel-hub.com
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Storage (S3/MinIO-compatible) — CV imagery + field-report uploads. Defaults
# below work out of the box with the minio/minio-init services in
# infra/docker-compose.yml; point at real S3 in production.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=aether-media
STORAGE_ACCESS_KEY_ID=aether
STORAGE_SECRET_ACCESS_KEY=aether-dev-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

AI_ENGINE_PORT=8000
BACKEND_PORT=4000
FRONTEND_PORT=3000

# --- apps/web (build args, inlined at Next.js build time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
