# --- Shared / compose-level ---
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether
POSTGRES_DB=aether
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- apps/api ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://aether:aether@postgres:5432/aether
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AI_ENGINE_URL=http://ai-engine:8000
INTERNAL_SERVICE_TOKEN=dev-internal-token
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@aether.local
ADMIN_PASSWORD=ChangeMe123!

# Ingestion adapters
BMKG_POLL_INTERVAL_MS=300000
NASA_FIRMS_POLL_INTERVAL_MS=3600000
WEATHER_POLL_INTERVAL_MS=900000
LANDSLIDE_TRIGGER_POLL_INTERVAL_MS=900000
SENTINEL_POLL_INTERVAL_MS=3600000
PETABENCANA_POLL_INTERVAL_MS=900000
RISK_NOTIFICATION_THRESHOLD=60

# Phase 2 ingestion adapters — weather/FIRMS/Sentinel credentials are blank
# until you supply real ones (each adapter gracefully no-ops without them);
# NASA_FIRMS_BASE_URL/SENTINEL_BASE_URL have working public defaults.
# Flood no longer depends on this (see PetaBencana below); landslide no
# longer depends on this either (see Open-Meteo below) — this is only for
# a general-purpose station-based rainfall/water-level provider if one is
# ever configured.
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
NASA_FIRMS_API_KEY=
# Comma-separated FIRMS products; blank = MODIS_NRT,VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
NASA_FIRMS_SOURCES=
# Days of FIRMS hotspots kept (daily purge at 03:00; referenced detections are kept). 0 = keep forever.
HOTSPOT_RETENTION_DAYS=90
SENTINEL_BASE_URL=https://services.sentinel-hub.com
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# PetaBencana.id flood-gauge feed (petabencana.adapter.ts) — real, free,
# no API key required, unlike the adapters above. Defaults to Jakarta plus
# West/Central/East Java (ID-JK,ID-JB,ID-JT,ID-JI) — PetaBencana's current
# coverage, not nationwide; both vars are commented out to use the
# adapter's built-in defaults, uncomment only to override.
# PETABENCANA_BASE_URL=https://data.petabencana.id
# PETABENCANA_ADMIN_CODES=ID-JK,ID-JB,ID-JT,ID-JI

# BNPB InaRISK hazard-index lookup (bnpb-inarisk.client.ts) — real, free,
# no API key required. Nationwide coverage; enriches PetaBencana flood
# events and rainfall-triggered landslide candidates with a per-coordinate
# hazard index. Commented out to use the built-in default.
# BNPB_INARISK_BASE_URL=https://gis.bnpb.go.id/server/rest/services/inarisk

# Open-Meteo rainfall lookup (open-meteo.client.ts) — real, free, no API
# key. Landslide's independent rainfall-trigger source (real observed 24h
# rainfall per district centroid). Commented out to use the built-in default.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# OpenAQ (air-quality.service.ts) — measured PM2.5/PM10 from the nearest
# active monitor or low-cost sensor for the citizen home page. Free key from
# https://explore.openaq.org/register. Optional: without it the card shows
# the CAMS model (Open-Meteo, keyless) only.
# OPENAQ_API_KEY=

# Web Push for citizen emergency alarms (public-alerts module). Optional:
# without these, alarms only appear in browser tabs that are already open.
# Generate a pair with `npx web-push generate-vapid-keys`; VAPID_SUBJECT is a
# contact URL the push services can reach (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aether.local

# Reverse geocoding (GPS → kecamatan/desa) for the citizen portal's
# automatic location. Public OSM Nominatim allows max 1 request/second
# (enforced in-process); use a self-hosted instance for production.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Storage (S3/MinIO-compatible) — CV imagery + field-report uploads. Defaults
# below work out of the box with the minio/minio-init services in
# infra/docker-compose.yml; point at real S3 in production.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=aether-media
STORAGE_ACCESS_KEY_ID=aether
STORAGE_SECRET_ACCESS_KEY=aether-dev-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# village-population-import background jobs (BullMQ, same REDIS_URL Redis
# instance as CacheService — no separate queue infra to stand up). Chunk
# size controls both how many CSV rows are batched per DB write during
# validation/import and (indirectly, given the in-memory village lookup)
# working-set size; concurrency controls how many batches each phase
# processes at once within a single API process (see docs on running a
# standalone worker in village-population-import/README.md).
VILLAGE_POPULATION_IMPORT_CHUNK_SIZE=2000
VILLAGE_POPULATION_IMPORT_VALIDATION_CONCURRENCY=1
VILLAGE_POPULATION_IMPORT_CONFIRM_CONCURRENCY=1

# --- Karhutla spread + smoke predictions (apps/api karhutla-prediction/) ---
# All optional. Scheduled run interval (0 disables; manual runs still work),
# clusters forecast per run, and how far back FIRMS hotspots are considered.
# Weather/terrain come from OPEN_METEO_BASE_URL (keyless); settlements from
# the public Overpass API (fair use, 24 h cache) — set
# KARHUTLA_SETTLEMENTS_ENABLED=false to skip it. See docs/KARHUTLA_PREDICTION.md.
KARHUTLA_PREDICTION_INTERVAL_MS=10800000
KARHUTLA_MAX_CLUSTERS=8
KARHUTLA_HOTSPOT_WINDOW_HOURS=24
KARHUTLA_SETTLEMENTS_ENABLED=true

# AETHER Ground Intelligence — community reports per reporter per rolling hour.
GROUND_REPORTS_MAX_PER_HOUR=10
# OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# --- Rainfall Intelligence (apps/api rainfall-intelligence/) ---
# Hourly Open-Meteo weather for every kabupaten/kota point, stored in
# weather_hourly_samples. Interval between ingestion runs (0 disables; manual
# runs still work). Each run backfills to the last stored hour, so a longer
# interval loses freshness, not data. Default 3 h ≈ 4.5k Open-Meteo calls/day
# — the free tier is 10k/day (non-commercial) and SHARED with every other
# Open-Meteo caller in apps/api. See docs/RAINFALL_INTELLIGENCE.md.
RAINFALL_INGESTION_INTERVAL_MS=10800000
# JAXA GSMaP_NOW satellite rainfall. Register (free) at
# https://sharaku.eorc.jaxa.jp/GSMaP/registration.html — the FTP user and
# password arrive by email. Leave blank to skip GSMaP ingestion. Plain FTP
# (no TLS). Attribution required: "GSMaP data by Japan Aerospace Exploration
# Agency (JAXA)". apps/api reads apps/api/.env when run locally.
GSMAP_FTP_HOST=hokusai.eorc.jaxa.jp
GSMAP_FTP_USER=
GSMAP_FTP_PASSWORD=
GSMAP_INGESTION_INTERVAL_MS=3600000
# Landslide baseline terrain: districts per rolling 24 h whose DEM slope is
# sampled via Open-Meteo's elevation API (64 coordinates each; 0 disables).
TERRAIN_SAMPLING_DISTRICTS_PER_DAY=60
# Hazard backtest (Milestone 7): archived GSMaP_Gauge hourly rainfall from
# this UTC day, days added per daily top-up (bulk: npm run rainfall:archive),
# and the first year of BNPB DIBI flood/landslide reports used as labels.
GSMAP_ARCHIVE_FROM=2024-01-01
GSMAP_ARCHIVE_DAYS_PER_RUN=4
DIBI_LABELS_FROM_YEAR=2023

AI_ENGINE_PORT=8000
BACKEND_PORT=4000
FRONTEND_PORT=3000

# --- apps/web (build args, inlined at Next.js build time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# CARTO basemaps key (https://carto.com/basemaps/apikey) — without it every
# street map shows "API KEY REQUIRED" tiles. `next dev` reads apps/web/.env.local,
# not this file, so set it there locally.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
