{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "generate": {
      "cache": false
    },
    "@aether/api#generate": {
      "cache": false
    },
    "@aether/contracts#generate": {
      "dependsOn": ["@aether/api#generate"],
      "cache": false,
      "outputs": ["src/generated.ts"]
    }
  }
}
